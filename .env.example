# --- BACKEND SETTINGS ---
PORT=8000
HOST=0.0.0.0
AUDIUS_APP_NAME=AURORA_MUSIC
JAMENDO_CLIENT_ID=b6747d04

# --- OPTIONAL SPOTIFY API CREDENTIALS ---
